#! /bin/sh

if [ -z "$BTRACE_HOME" -o ! -d "$BTRACE_HOME" ]; then
  PRG="$0"
  progname=$(basename "$0")
  PRG=$(readlink "$PRG")
  if [ -z "$PRG" ]; then PRG=$0; fi
  BTRACE_HOME=$(dirname "$PRG")/..
  BTRACE_HOME=$(cd "$BTRACE_HOME" && pwd)
fi

JAVA_ARGS="-XX:+IgnoreUnrecognizedVMOptions"

CLIENT_JAR="${BTRACE_HOME}/libs/btrace.jar"
if [ -f "${CLIENT_JAR}" ]; then
  if [ -d "${JAVA_HOME}" ]; then
    CP="${CLIENT_JAR}"
    ${JAVA_HOME}/bin/java ${JAVA_ARGS} -Dbtrace.client.main=io.btrace.extcli.Main -cp ${CP} io.btrace.boot.Loader "$@"
  else
    echo "Please set a valid JAVA_HOME before running this script"
    exit 1
  fi
else
  echo "Please set BTRACE_HOME before running this script"
  exit 1
fi
