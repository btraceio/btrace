<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <name>BTrace Maven Plugin</name>
  <description>Compatibility stub for the unsupported BTrace 3.0 Maven fat-agent goal</description>
  <groupId>io.btrace</groupId>
  <artifactId>btrace-maven-plugin</artifactId>
  <version>@VERSION@</version>
  <goalPrefix>btrace</goalPrefix>

  <mojos>
    <mojo>
      <goal>fat-agent</goal>
      <description>Fails explicitly because Maven fat-agent packaging is not supported in BTrace 3.0</description>
      <implementation>io.btrace.maven.FatAgentMojo</implementation>
      <language>java</language>
      <phase>package</phase>
      <parameters>
        <parameter>
          <name>skip</name>
          <type>boolean</type>
          <required>false</required>
          <editable>true</editable>
          <description>Skip execution</description>
        </parameter>
      </parameters>

      <configuration>
        <skip implementation="boolean" default-value="false">${btrace.skip}</skip>
      </configuration>
    </mojo>
  </mojos>
</plugin>
